import React,{useState} from "react";export default function AllCredentials({credentials,onCreate}){const[q,Q]=useState("");let rows=credentials.filter(c=>(c.recipient+" "+c.title+" "+c.email).toLowerCase().includes(q.toLowerCase()));return <div className="page-content"><div className="page-heading"><div><small className="eyebrow">CREDENTIAL MANAGEMENT</small><h1>All credentials</h1><p>Track and manage every credential issued from your workspace.</p></div><button className="btn-primary" onClick={onCreate}>＋ Issue credential</button></div><div className="toolbar"><input placeholder="⌕  Search recipient or credential" value={q} onChange={e=>Q(e.target.value)}/><small>{rows.length} results</small></div><div className="table-wrap"><table><thead><tr><th>RECIPIENT</th><th>CREDENTIAL</th><th>ISSUED</th><th>STATUS</th></tr></thead><tbody>{rows.map(c=><tr key={c.id}><td><b>{c.recipient}</b><small>{c.email||"No email"}</small></td><td>{c.title}</td><td>{new Date(c.issuedAt).toLocaleDateString()}</td><td><em>Issued</em></td></tr>)}</tbody></table>{!rows.length&&<div className="empty-small">No credentials found.</div>}</div></div>}
