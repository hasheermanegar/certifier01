import React, { useState } from "react";

const uid = () => crypto.randomUUID();

export default function Pathways({
  pathways = [],
  designs = [],
  recipients = [],
  onSave,
  onDelete
}) {
  const [showForm, setShowForm] = useState(false);
  const [selected, setSelected] = useState(null);
  const [search, setSearch] = useState("");

  const blank = {
    id: uid(),
    name: "",
    description: "",
    designIds: [],
    enrolled: [],
    createdAt: new Date().toISOString()
  };

  const [form, setForm] = useState(blank);

  const openNew = () => {
    setForm({ ...blank, id: uid(), designIds: [], enrolled: [] });
    setSelected(null);
    setShowForm(true);
  };

  const openEdit = p => {
    setForm({ ...p });
    setSelected(p.id);
    setShowForm(true);
  };

  const save = e => {
    e.preventDefault();
    if (!form.name.trim()) return;
    onSave({
      ...form,
      name: form.name.trim(),
      description: form.description.trim()
    });
    setShowForm(false);
  };

  const toggleDesign = id => {
    setForm(p => ({
      ...p,
      designIds: p.designIds.includes(id)
        ? p.designIds.filter(x => x !== id)
        : [...p.designIds, id]
    }));
  };

  const toggleRecipient = (pathwayId, recipientId) => {
    const pathway = pathways.find(p => p.id === pathwayId);
    if (!pathway) return;
    const enrolled = pathway.enrolled || [];
    onSave({
      ...pathway,
      enrolled: enrolled.includes(recipientId)
        ? enrolled.filter(id => id !== recipientId)
        : [...enrolled, recipientId]
    });
  };

  const filtered = pathways.filter(p =>
    `${p.name} ${p.description}`.toLowerCase().includes(search.toLowerCase())
  );

  const getDesignName = id =>
    designs.find(d => d.id === id)?.name || "Deleted template";

  return (
    <div className="page-content">
      <div className="page-heading">
        <div>
          <small className="eyebrow">LEARNING & CREDENTIAL JOURNEYS</small>
          <h1>Pathways</h1>
          <p>Connect multiple credentials into structured achievement journeys.</p>
        </div>
        <button className="btn-primary" onClick={openNew}>＋ Create pathway</button>
      </div>

      <div className="stats-grid" style={{ marginBottom: 22 }}>
        <div className="stat-card"><span>Total pathways</span><strong>{pathways.length}</strong></div>
        <div className="stat-card"><span>Available templates</span><strong>{designs.length}</strong></div>
        <div className="stat-card"><span>Recipients enrolled</span><strong>{pathways.reduce((n,p) => n + (p.enrolled?.length || 0), 0)}</strong></div>
      </div>

      <div className="toolbar">
        <input
          placeholder="⌕ Search pathways..."
          value={search}
          onChange={e => setSearch(e.target.value)}
        />
        <small>{filtered.length} pathways</small>
      </div>

      {filtered.length ? (
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fill,minmax(280px,1fr))", gap: 18 }}>
          {filtered.map(p => (
            <div className="table-wrap" key={p.id} style={{ padding: 22 }}>
              <div style={{ display: "flex", justifyContent: "space-between", gap: 12 }}>
                <div>
                  <small className="eyebrow">CREDENTIAL PATHWAY</small>
                  <h2 style={{ fontSize: 19, margin: "10px 0" }}>{p.name}</h2>
                </div>
                <span style={{ color: "#315eea", fontSize: 24 }}>◇</span>
              </div>
              <p style={{ color: "#8290a7", minHeight: 42 }}>{p.description || "No description added."}</p>
              <div style={{ display: "flex", gap: 18, margin: "18px 0", color: "#64748b", fontSize: 13 }}>
                <span>▤ {p.designIds?.length || 0} credentials</span>
                <span>♙ {p.enrolled?.length || 0} enrolled</span>
              </div>
              <div style={{ display: "flex", gap: 8, flexWrap: "wrap" }}>
                <button className="btn-primary" onClick={() => openEdit(p)}>Manage</button>
                <button className="btn-secondary" onClick={() => {
                  if (window.confirm(`Delete pathway "${p.name}"?`)) onDelete(p.id);
                }}>Delete</button>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div className="empty-state">
          <h2>No pathways yet</h2>
          <p>Create a pathway to group credential templates into a learning journey.</p>
          <button className="btn-primary" onClick={openNew}>＋ Create your first pathway</button>
        </div>
      )}

      {showForm && (
        <div className="modal-backdrop">
          <form className="modal-card" onSubmit={save}>
            <div className="modal-head">
              <div>
                <small className="eyebrow">PATHWAY BUILDER</small>
                <h2>{selected ? "Edit pathway" : "Create pathway"}</h2>
              </div>
              <button type="button" className="icon-btn" onClick={() => setShowForm(false)}>×</button>
            </div>

            <label>
              Pathway name
              <input required value={form.name} onChange={e => setForm(p => ({ ...p, name: e.target.value }))} placeholder="e.g. Full Stack Development" />
            </label>

            <label>
              Description
              <textarea rows="3" value={form.description} onChange={e => setForm(p => ({ ...p, description: e.target.value }))} placeholder="Describe this learning journey..." />
            </label>

            <label>Credential templates — select in pathway order</label>
            <div style={{ border: "1px solid #e2e8f0", borderRadius: 10, padding: 12, maxHeight: 220, overflowY: "auto" }}>
              {!designs.length && <p>No design templates available. Create one in Design Templates first.</p>}
              {designs.map(d => (
                <label key={d.id} style={{ display: "flex", alignItems: "center", gap: 10, padding: 8 }}>
                  <input type="checkbox" checked={form.designIds.includes(d.id)} onChange={() => toggleDesign(d.id)} />
                  <span>{d.name}</span>
                </label>
              ))}
            </div>

            {form.designIds.length > 0 && (
              <div style={{ marginTop: 12 }}>
                <b>Selected sequence</b>
                {form.designIds.map((id, i) => (
                  <div key={id} style={{ display: "flex", alignItems: "center", gap: 10, padding: 7 }}>
                    <span>{i + 1}.</span>
                    <span style={{ flex: 1 }}>{getDesignName(id)}</span>
                    <button type="button" className="btn-secondary" disabled={i === 0} onClick={() => setForm(p => {
                      const a = [...p.designIds];
                      [a[i - 1], a[i]] = [a[i], a[i - 1]];
                      return { ...p, designIds: a };
                    })}>↑</button>
                    <button type="button" className="btn-secondary" disabled={i === form.designIds.length - 1} onClick={() => setForm(p => {
                      const a = [...p.designIds];
                      [a[i + 1], a[i]] = [a[i], a[i + 1]];
                      return { ...p, designIds: a };
                    })}>↓</button>
                  </div>
                ))}
              </div>
            )}

            <div className="modal-actions">
              <button type="button" className="btn-secondary" onClick={() => setShowForm(false)}>Cancel</button>
              <button className="btn-primary">{selected ? "Save changes" : "Create pathway"}</button>
            </div>
          </form>
        </div>
      )}

      {pathways.map(p => (
        <div key={p.id} style={{ display: "none" }}>
          {recipients.length}
        </div>
      ))}
    </div>
  );
}
