import React from "react";const items=["Dashboard","Credential Templates","All Credentials","Recipients","Pathways","Analytics","Design Templates","Email Templates","Forms","Integrations","Getting Started","Credential Usage","Settings","Help Center"];const icons=["⌂","▤","▧","♙","◇","▥","▧","✉","▣","⌘","✦","◷","⚙","?"];export default function Sidebar({page,setPage}){return <aside className="sidebar"><div className="brand"><b className="brand-mark">C</b>certify<span>pro</span></div><div className="workspace-switch"><b>H</b><span>My workspace<small>Free plan</small></span>⌄</div><div className="quick-search">⌕　Quick search <kbd>⌘ K</kbd></div><small className="nav-label">WORKSPACE</small>{items.slice(0,10).map((x,i)=><button key={x} className={`nav-item ${page===x?"active":""}`} onClick={()=>setPage(x)}><span>{icons[i]}</span>{x}</button>)}<small className="nav-label support">SUPPORT</small>{items.slice(10).map((x,i)=><button key={x} className={`nav-item ${page===x?"active":""}`} onClick={()=>setPage(x)}><span>{icons[i+10]}</span>{x}</button>)}<div className="sidebar-bottom"><b>Make every achievement count</b><p>Explore more ways to issue credentials.</p><div className="profile"><b>MH</b><span>Mohammad Hasheer<small>Administrator</small></span></div></div></aside>}
